  const dashLink = document.querySelector('.nav-link-dash');
  const regLink = document.querySelector('.nav-link-reg');

  if (currentUser) {
    if (dashLink) dashLink.style.display = '';
    // Show logout option
  } else {
    if (dashLink) dashLink.style.display = 'none';
  }
}

